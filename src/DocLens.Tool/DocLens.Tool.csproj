<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Pack as a .NET global/local tool: `dotnet tool install -g DocLens.Tool` -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>doclens</ToolCommandName>
    <PackageId>DocLens.Tool</PackageId>
    <Version>0.2.0</Version>
    <Authors>DocLens</Authors>
    <Description>Command-line tool that generates a self-contained HTML API reference for a .NET assembly from its XML documentation. A Swagger/DocFX alternative for class libraries.</Description>
    <PackageTags>documentation;api;cli;dotnet-tool;swagger-alternative</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DocLens.Core\DocLens.Core.csproj" />
  </ItemGroup>

</Project>
